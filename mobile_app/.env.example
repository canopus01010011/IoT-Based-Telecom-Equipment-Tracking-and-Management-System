# Copy to .env
# Railway (production):
EXPO_PUBLIC_API_URL=https://perceptive-energy-production-a390.up.railway.app/api

# Google Maps — Directions API (road-following routes on the map)
# https://console.cloud.google.com/ → enable "Directions API"
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Local dev (physical phone — use PC LAN IP, not localhost):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api
